# Used only to create the first admin account. Replace this with your own long secret.
ADMIN_SETUP_KEY=replace-this-with-a-long-private-setup-key
# Set this to the live HTTPS origin before deployment (no trailing path).
# PUBLIC_ORIGIN=https://example.com
# Local LibreTranslate endpoint (see docker-compose.yml).
LIBRETRANSLATE_URL=http://127.0.0.1:5001/translate
